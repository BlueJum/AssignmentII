<!-- Horizontal card:
       Source: Bootstrap 5.0 docs, Cards > Horizontal
       https://getbootstrap.com/docs/5.0/components/card/#horizontal -->

<div class="card mb-4">
  <div class="row g-0">
    <div class="col-md-4">
      <img src="/assets/profile.jpg" class="img-fluid rounded-start" alt="Profile photo of Archer Keshtkar Bagheri">
    </div>
    <div class="col-md-8">
      <div class="card-body">
        <h5 class="card-title">Hello!</h5>
        <p class="card-text">I am a cybersecurity student studying Web and Scripting Programming. I enjoy developing modern web applications using traditional and modern frameworks.</p>
        <p class="card-text"><small class="text-muted"><i class="fa-solid fa-user-secret"></i> Archer Keshtkar Bagheri</small></p>
      </div>
    </div>
  </div>
</div>

 <!-- Card with a header, holding the intro video.
       Source: Bootstrap 5.0 docs, Cards > Header and footer
       https://getbootstrap.com/docs/5.0/components/card/#header-and-footer -->

<div class="card">
  <div class="card-header">
    <i class="fa-sold fa-video"></i> Introductory video
  </div>
    <div class="card-body text-center">
      <p class="card-text">Watch my short video introduction below:</p>

      <video class="w-100" style="max-width: 400px" controls poster="/assets/poster.jpg">
        <source src="/assets/intro.mp4" type="video/mp4">
        Browser does not support HTML5 video.
      </video>
    </div>
  </div>
</div>
